{
  "name": "altiora-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "npm --prefix .. run build",
    "build": "tsc -p tsconfig.json",
