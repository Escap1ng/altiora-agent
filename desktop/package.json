{
  "name": "altiora-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "description": "Altiora desktop shell",
  "author": "Escap1ng",
  "scripts": {
    "prebuild": "npm --prefix .. run build && node scripts/copy-core.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "npm run build && electron-builder --win nsis",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.altiora.desktop",
    "productName": "Altiora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "core-dist/**/*",
      "preload.cjs",
      "renderer/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp"
    }
  }
}
